{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lexora-official",
  "main": "dist/server/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/web/*", "/version.json", "/beta-version.json"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "autoword-downloads"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexora-web-usage",
      "database_id": "a82eb8f0-4b0a-46e8-b562-55f9e48766ae"
    }
  ],
  "vars": {
    "WEB_ORIGIN": "https://dict.12323456.xyz"
  },
  "routes": [
    {
      "pattern": "lexora.12323456.xyz/*",
      "zone_name": "12323456.xyz"
    }
  ],
  "observability": {
    "enabled": true
  }
}
